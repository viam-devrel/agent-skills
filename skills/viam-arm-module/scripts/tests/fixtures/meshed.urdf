<robot name="meshed">
  <link name="base">
    <visual>
      <origin xyz="0.01 0.02 0.03" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://some_pkg/meshes/base.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="link1">
    <!-- Carries BOTH a visual and a collision mesh reference (neither
         resolvable, same as base's), so a visual/collision pairing bug
         in mesh inspection would surface as a wrong kind, path, or
         origin on this link, not go uncaught. -->
    <visual>
      <geometry>
        <mesh filename="meshes/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/link1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base"/><child link="link1"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1"/>
  </joint>
</robot>
